{
  "name": "uncedo-monorepo",
  "private": true,
  "workspaces": [
    "web",
    "admin",
    "helpers-web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=uncedo-admin",
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=uncedo-admin",
    "dev:helpers": "npm run dev --workspace=uncedo-helpers-web",
    "build": "npm run build --workspace=uncedo-admin",
    "build:web": "npm run build --workspace=web",
    "build:helpers": "npm run build --workspace=uncedo-helpers-web",
    "build:admin": "npm run build --workspace=uncedo-admin",
    "lint": "npm run build --workspace=web && npm run build --workspace=uncedo-helpers-web && npm run build --workspace=uncedo-admin",
    "validate:rewards:shared": "node scripts/validate-reward-shared.cjs",
    "test:constants": "node scripts/validate-reward-constants.js",
    "test:rules": "firebase emulators:exec --project demo-uncedo-phase0 --only auth,firestore,storage \"node --test functions/test/firestore.rules.test.js\"",
    "test:rewards:integration": "firebase emulators:exec --project demo-uncedo-phase0 --only auth,firestore \"node --test functions/test/rewards.integration.test.js functions/test/rewards.test.js\"",
    "test:phase0": "npm run test:rules && npm run test:rewards:integration"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "firebase-admin": "12.7.0",
    "firebase-functions": "^7.4.0",
    "h3-js": "^4.5.0",
    "pdfkit": "^0.20.2",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.23.0",
    "vite-plugin-pwa": "^0.21.2"
  }
}
