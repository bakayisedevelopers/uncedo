{
  "name": "uncedo-monorepo",
  "private": true,
  "workspaces": [
    "web",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=uncedo-admin",
    "build": "npm run build --workspace=uncedo-admin",
    "lint": "npm run build --workspace=uncedo-admin",
    "validate:rewards:shared": "node scripts/validate-reward-shared.cjs",
    "test:constants": "node scripts/validate-reward-constants.js",
    "test:rules": "firebase emulators:exec --project demo-uncedo-phase0 --only auth,firestore,storage \"node --test functions/test/firestore.rules.test.js\"",
    "test:rewards:integration": "firebase emulators:exec --project demo-uncedo-phase0 --only auth,firestore \"node --test functions/test/rewards.integration.test.js functions/test/rewards.test.js\"",
    "test:phase0": "npm run test:rules && npm run test:rewards:integration"
  },
  "dependencies": {
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.23.0"
  }
}
