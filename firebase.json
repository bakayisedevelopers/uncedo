{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "bakayise-uncedo-latest",
      "public": "web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/payment",
          "headers": [
            { "key": "Cache-Control", "value": "no-store, max-age=0" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "X-Content-Type-Options", "value": "nosniff" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Referrer-Policy", "value": "no-referrer" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/verify-paystack",
          "function": "verifyPaystack"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "bakayise-uncedo-latest-admin",
      "public": "admin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "bakayise-uncedo-latest-helpers",
      "public": "helpers/dist",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/app.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/sign-agreement",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/sign-in",
          "destination": "/app.html"
        },
        {
          "source": "/sign-up",
          "destination": "/app.html"
        },
        {
          "source": "/sign-agreement",
          "destination": "/app.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "hosting": {
      "host": "0.0.0.0",
      "port": 5000
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
