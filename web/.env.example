# Public Vite settings only. VITE_* values are embedded in the browser build.
# These are placeholders; the current marketing website does not read them yet.
VITE_FIREBASE_API_KEY=PASTE_FIREBASE_WEB_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=PASTE_FIREBASE_AUTH_DOMAIN_HERE
VITE_FIREBASE_PROJECT_ID=PASTE_FIREBASE_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=PASTE_FIREBASE_STORAGE_BUCKET_HERE
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_FIREBASE_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=PASTE_WEBSITE_APP_ID_HERE
VITE_FIREBASE_DATABASE_URL=PASTE_REALTIME_DATABASE_URL_HERE
# Optional Functions base URL. Defaults to the project's us-central1 Functions endpoint.
VITE_API_BASE_URL=
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_WHATSAPP_AUTH_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false
