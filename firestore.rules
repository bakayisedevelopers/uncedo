rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (
          ('email' in request.auth.token && request.auth.token.email == 'jabuobed1@gmail.com')
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
              || ('roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && 'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
            )
          )
        );
    }

    function isRequestParticipant(data) {
      return signedIn()
        && (
          data.get('studentId', '') == request.auth.uid
          || data.get('tutorId', '') == request.auth.uid
          || data.get('currentOfferTutorId', '') == request.auth.uid
        );
    }

    function isSessionParticipant(data) {
      return signedIn()
        && (
          data.get('studentId', '') == request.auth.uid
          || data.get('tutorId', '') == request.auth.uid
        );
    }

    function hasOnlySafeUserFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ratings', 'metrics', 'wallet', 'paymentMethods', 'verificationStatus', 'payout',
        'referralRewardCount', 'rewardAccount', 'rewards', 'membership', 'mastery',
        'eligibleCompletedPaidBookings', 'eligibleCompletedPaidJobs', 'completedJobs',
        'completionCounters', 'acceptanceRate', 'cancellationRate', 'completionRate',
        'responseMetrics', 'earningsTotals', 'admin', 'adminNotes', 'blocked',
        'isBlocked', 'suspended', 'isSuspended', 'role', 'roles', 'activeRole',
        'isAdmin', 'accountStatus', 'restrictedStatus', 'dispatchPaused'
      ]);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (signedIn() && resource.data.get('activeRole', '') == 'tutor');
      allow list: if isAdmin() || signedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && hasOnlySafeUserFieldChanges());
      allow delete: if isOwner(userId) || isAdmin();

      match /aiLogs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /classRequests/{requestId} {
      allow get, list: if isAdmin() || isRequestParticipant(resource.data);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || isRequestParticipant(resource.data) || isRequestParticipant(request.resource.data);
      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAdmin()
          || isRequestParticipant(get(/databases/$(database)/documents/classRequests/$(requestId)).data);
        allow create, update, delete: if isAdmin();
      }
    }

    match /sessions/{sessionId} {
      allow get, list: if isAdmin() || isSessionParticipant(resource.data);
      allow create: if isAdmin() || isSessionParticipant(request.resource.data);
      allow update: if isAdmin() || isSessionParticipant(resource.data) || isSessionParticipant(request.resource.data);
      allow delete: if isAdmin();

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin() || isSessionParticipant(get(/databases/$(database)/documents/sessions/$(sessionId)).data);
      }
    }

    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || isOwner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && !(request.resource.data.type in ['points_earned', 'points_deducted', 'referral_stage_achieved', 'membership_level_achieved', 'helper_mastery_level_achieved', 'points_expiring_soon', 'reward_reversed']);
      allow update: if isAdmin() || (isOwner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /emailEvents/{eventId} {
      allow create: if signedIn();
      allow get, list, update, delete: if isAdmin();
    }

    match /tutorDocuments/{documentId} {
      allow get, list: if isAdmin() || isOwner(resource.data.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.uid);
      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    match /unsupportedSubjectRequests/{subjectId} {
      allow read: if isAdmin();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /system/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /serviceCatalog/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    function isHelperServiceOwner(helperId) {
      return signedIn() && request.auth.uid == helperId;
    }

    function isSafeHelperServiceApplication(helperId) {
      return isHelperServiceOwner(helperId)
        && request.resource.data.helperId == helperId
        && request.resource.data.status == 'pending'
        && request.resource.data.active == false
        && request.resource.data.approved == false
        && request.resource.data.verified == false;
    }

    match /helperServices/{offeringId} {
      allow get, list: if isAdmin() || signedIn();
      allow create: if isAdmin() || isSafeHelperServiceApplication(request.resource.data.helperId);
      allow update: if isAdmin()
        || (
          isHelperServiceOwner(resource.data.helperId)
          && request.resource.data.helperId == resource.data.helperId
          && request.resource.data.serviceId == resource.data.serviceId
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.status == resource.data.status
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.verified == resource.data.verified
        );
      allow delete: if isAdmin() || isHelperServiceOwner(resource.data.helperId);
    }

    match /helperDispatchIndex/{helperId} {
      allow get: if isAdmin() || isOwner(helperId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /customerServiceEvents/{eventId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow get, list: if isAdmin() || isOwner(resource.data.customerId);
      allow update, delete: if isAdmin();
    }

    match /customerRecommendationProfiles/{customerId} {
      allow read: if isAdmin() || isOwner(customerId);
      allow write: if isAdmin();
    }

    match /customerRecommendationTrainingSamples/{sampleId} {
      allow read, write: if isAdmin();
    }

    match /rewardConfig/{configId} {
      allow read: if signedIn();
      // Configuration changes go through the trusted versioning endpoint so
      // every write has an immutable history and audit entry.
      allow create, update, delete: if false;
    }

    match /rewardAccounts/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /referrals/{referredUserId} {
      allow get: if isOwner(referredUserId) || isOwner(resource.data.referrerUserId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow get, list: if isAdmin() || isOwner(resource.data.raterUserId) || isOwner(resource.data.ratedUserId);
      allow create, update, delete: if isAdmin();
    }

    match /ratingAccounts/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /services/{serviceId} {
        allow get, list: if signedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /helperMastery/{helperId} {
      allow get: if isOwner(helperId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      match /services/{serviceId} {
        allow get, list: if isOwner(helperId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    match /serviceCreditRedemptions/{redemptionId} {
      allow get, list: if isAdmin() || isOwner(resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    // Phase 3 operational records are written only by trusted server endpoints.  Admin
    // clients may inspect their audit trail but must not be able to fabricate awards.
    match /rewardConfigHistory/{historyId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /rewardCampaigns/{campaignId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.status == 'active' && resource.data.public == true);
      allow create, update, delete: if false;
      match /participants/{userId} {
        allow get: if isAdmin() || isOwner(userId);
        allow list: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /helperRewardBenefits/{benefitId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.active == true);
      allow create, update, delete: if false;
    }

    match /helperRewardRedemptions/{redemptionId} {
      allow get: if isAdmin() || isOwner(resource.data.helperId);
      allow list: if isAdmin() || (signedIn() && resource.data.helperId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /helperBenefitTokens/{tokenId} {
      allow get: if isAdmin() || isOwner(resource.data.helperId);
      allow list: if isAdmin() || (signedIn() && resource.data.helperId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /helperRecognitionCycles/{cycleId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.status in ['active', 'closed']);
      allow create, update, delete: if false;
      match /standings/{helperId} {
        allow get: if isAdmin() || isOwner(helperId);
        allow list: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /helperRecognitionAwards/{awardId} {
      allow get: if isAdmin() || isOwner(resource.data.helperId);
      allow list: if isAdmin() || (signedIn() && resource.data.helperId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /rewardOperationalSummaries/{summaryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /helperWeeklyPayouts/{payoutId} {
      allow get: if isAdmin() || (signedIn() && resource.data.helperId == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.helperId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    function isLinkedWhatsAppGuestCustomer(customerId) {
      return signedIn()
        && customerId is string
        && exists(/databases/$(database)/documents/whatsappGuestOwnership/$(customerId))
        && get(/databases/$(database)/documents/whatsappGuestOwnership/$(customerId)).data.uid == request.auth.uid;
    }

    function isServiceRequestParticipant(data) {
      return signedIn()
        && (
          data.get('customerId', '') == request.auth.uid
          || isLinkedWhatsAppGuestCustomer(data.get('customerId', ''))
          || (data.get('helperAssignment', null) != null && data.helperAssignment.get('helperId', '') == request.auth.uid)
          || data.get('currentOfferHelperId', '') == request.auth.uid
          || data.get('studentId', '') == request.auth.uid
          || data.get('tutorId', '') == request.auth.uid
          || data.get('currentOfferTutorId', '') == request.auth.uid
        );
    }

    function isCustomerCreatingSafeServiceRequest() {
      return signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['collecting_details', 'scheduled_pending', 'matching']
        && (!('helperAssignment' in request.resource.data) || request.resource.data.helperAssignment == null)
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == null)
        && (!('paymentTransactionId' in request.resource.data) || request.resource.data.paymentTransactionId == null)
        && (!('helperPayoutBreakdown' in request.resource.data) || request.resource.data.helperPayoutBreakdown == null)
        && (!('currentOfferHelperId' in request.resource.data) || request.resource.data.currentOfferHelperId == null)
        && (!('offerToken' in request.resource.data) || request.resource.data.offerToken == null);
    }

    function isCustomerUpdatingOwnServiceRequest() {
      return signedIn()
        && (resource.data.customerId == request.auth.uid || isLinkedWhatsAppGuestCustomer(resource.data.customerId))
        && request.resource.data.customerId == resource.data.customerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'helperAssignment', 'currentOfferHelperId', 'helperQueue', 'offerToken', 'offerExpiresAt',
          'offerRevision', 'offerCycleExcludedHelperIds', 'declinedHelperIds', 'lastOfferAt',
          'paymentStatus', 'paymentTransactionId', 'chargedCardLast4', 'helperPayoutBreakdown',
          'cancellationFeeAmount', 'endedAt', 'completedAt', 'ratings', 'metrics'
        ]);
    }

    function isOfferedHelperAcceptingServiceRequest() {
      // Offer acceptance is performed by an authenticated backend operation so
      // app and WhatsApp actions share token, revision, expiry, and concurrency checks.
      return false;
    }

    function isOfferedHelperDecliningServiceRequest() {
      // Offer decline is performed by the same authenticated backend operation.
      return false;
    }

    function isAssignedHelperUpdatingStatus() {
      return signedIn()
        && resource.data.helperAssignment != null
        && resource.data.helperAssignment.helperId == request.auth.uid
        && request.resource.data.helperAssignment.helperId == resource.data.helperAssignment.helperId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completionProofAttachments', 'completionProofCount', 'completionProofCapturedAt', 'updatedAt'
        ])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'customerId', 'pricingSnapshot', 'paymentStatus', 'paymentTransactionId',
          'chargedCardLast4', 'helperPayoutBreakdown', 'cancellationFeeAmount',
          'totalAmount', 'ratings'
        ]);
    }

    match /serviceRequests/{requestId} {
      allow get, list: if isAdmin() || isServiceRequestParticipant(resource.data);
      allow create: if isAdmin() || isCustomerCreatingSafeServiceRequest();
      allow update: if isAdmin()
        || isCustomerUpdatingOwnServiceRequest()
        || isOfferedHelperAcceptingServiceRequest()
        || isOfferedHelperDecliningServiceRequest()
        || isAssignedHelperUpdatingStatus();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
