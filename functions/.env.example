# Copy this file to functions/.env and replace every PASTE_* value.
# Never copy these values into Expo/web/admin environment variables.
# Do not deploy Functions while required values are still placeholders.

# Existing Paystack-backed mobile flows and payout functions
PAYSTACK_SECRET_KEY=PASTE_PAYSTACK_SECRET_KEY_HERE

# Request-linked, post-completion payment options. Keep false until deployment
# and the payment page/provider configuration have passed staging verification.
REQUEST_PAYMENTS_ENABLED=false
CUSTOMER_PAYMENT_URL=https://uncedo.bakayise.com/payment

# Existing queued email notifications
RESEND_API_KEY=PASTE_RESEND_API_KEY_HERE
EMAIL_FROM=PASTE_VERIFIED_SENDER_ADDRESS_HERE

# Official Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=PASTE_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_HERE
WHATSAPP_VERIFY_TOKEN=PASTE_A_RANDOM_WEBHOOK_VERIFY_TOKEN_HERE
META_APP_SECRET=PASTE_META_APP_SECRET_HERE
GRAPH_API_VERSION=PASTE_REVIEWED_GRAPH_API_VERSION_HERE
# Comma-separated names, and only after Meta approves each template.
APPROVED_TEMPLATE_NAMES=
# WhatsApp browser/app authentication. The approved auth template must accept
# one body text parameter containing the six digit code.
WHATSAPP_AUTH_ENABLED=false
WHATSAPP_MESSAGING_ENABLED=false
WHATSAPP_AUTH_TEMPLATE_NAME=PASTE_APPROVED_META_AUTH_TEMPLATE_NAME_HERE
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE

# Server-side assistant. Keep disabled until the model is configured and reviewed.
WHATSAPP_AI_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_RELAY_ENABLED=false
WHATSAPP_PAYMENTS_ENABLED=false
WHATSAPP_CANCELLATION_ENABLED=false
WHATSAPP_MEDIA_ENABLED=false
WHATSAPP_IMAGE_INTERPRETATION_ENABLED=false
WHATSAPP_TRANSCRIPTION_ENABLED=false
# Set true only after a Cloud Storage lifecycle rule enforces the configured retention period.
WHATSAPP_MEDIA_RETENTION_ENFORCED=false
WHATSAPP_TRANSCRIPTION_MODEL=PASTE_REVIEWED_OPENAI_TRANSCRIPTION_MODEL_HERE
WHATSAPP_SUPPORT_ENABLED=false
WHATSAPP_HELPER_OFFER_TEMPLATE_NAME=PASTE_APPROVED_META_TEMPLATE_NAME_HERE
WHATSAPP_HELPER_OFFER_TEMPLATE_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_SUPPORT_REPLY_TEMPLATE_NAME=PASTE_APPROVED_META_TEMPLATE_NAME_HERE
WHATSAPP_SUPPORT_REPLY_TEMPLATE_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_HELPER_ASSIGNED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_HELPER_ASSIGNED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_HELPER_ON_THE_WAY_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_HELPER_ON_THE_WAY_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_SERVICE_STARTED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_SERVICE_STARTED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_SERVICE_COMPLETED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_SERVICE_COMPLETED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_BOOKING_CANCELED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_BOOKING_CANCELED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
WHATSAPP_TEMPLATE_PAYMENT_REQUIRED_NAME=PASTE_APPROVED_TEMPLATE_NAME_HERE
WHATSAPP_TEMPLATE_PAYMENT_REQUIRED_LANGUAGE=PASTE_APPROVED_TEMPLATE_LANGUAGE_HERE
OPENAI_API_KEY=PASTE_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
