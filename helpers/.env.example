# Client-side Expo configuration. These values are public in the app bundle.
# Do not put Firebase Admin, Meta, Paystack secret, or other backend credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_FIREBASE_WEB_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_FIREBASE_AUTH_DOMAIN_HERE
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PASTE_FIREBASE_PROJECT_ID_HERE
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_FIREBASE_STORAGE_BUCKET_HERE
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_FIREBASE_MESSAGING_SENDER_ID_HERE
EXPO_PUBLIC_FIREBASE_APP_ID=PASTE_HELPER_APP_ID_HERE
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=PASTE_MEASUREMENT_ID_IF_USED
EXPO_PUBLIC_FIREBASE_DATABASE_URL=PASTE_REALTIME_DATABASE_URL_HERE
EXPO_PUBLIC_WEB_APP_URL=https://uncedo.bakayise.com
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=PASTE_RESTRICTED_GOOGLE_MAPS_KEY_HERE
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
EXPO_PUBLIC_WHATSAPP_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
