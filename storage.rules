rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (
          ('email' in request.auth.token && request.auth.token.email == 'jabuobed1@gmail.com')
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && (
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
              || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
              || ('roles' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
                && 'admin' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles)
            )
          )
        );
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function validRequestAttachment() {
      return request.resource != null
        && request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // Catalogue images are public content; only administrators may change them.
    match /service-catalog/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /helper-profile-photos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && validImage(10 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /helper-services/{serviceId}/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && validImage(10 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /service-request-references/{userId}/{requestId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validRequestAttachment();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /helper-completion-proof/{userId}/{requestId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validImage(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /helper-agreements/{userId}/{version}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if isAdmin();
    }

    match /uploads/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && validRequestAttachment();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
